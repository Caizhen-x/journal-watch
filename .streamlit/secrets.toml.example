# Copy this file to .streamlit/secrets.toml (gitignored) for local development.
# On Streamlit Cloud, paste the same content into the app's Secrets section.

# Password the group will share to access the hosted app.
app_password = "change-me-pick-something-memorable"

# Optional: Google Form URL for the "Subscribe to weekly digest" button on the homepage.
# Leave this line out (or empty) and the button disappears. When set, the button
# opens this URL in a new tab. Use the Form's "responder" link, not the editor link.
# subscribe_form_url = "https://docs.google.com/forms/d/e/SOMETHING/viewform"
